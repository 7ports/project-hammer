# Server (Node/Express) — environment template.
# Copy to `.env` for local dev; production values are set via `fly secrets`.

# Required: aisstream.io API key. Server-side only — never sent to the browser.
AISSTREAM_API_KEY=your_aisstream_api_key_here

# Optional fallback providers.
APRSFI_API_KEY=
VESSEL_API_KEY=

# Ordered comma-separated provider list. Default: aisstream
AIS_PROVIDER_ORDER=aisstream

# Allowed CORS origin for the frontend.
CORS_ORIGIN=http://localhost:5173

# TCP port the Express server listens on.
PORT=3001

# Storage (SQLite) path.
# Default in dev: ./data/hammer.db (local file, gitignored).
# Default in prod (NODE_ENV=production): /data/hammer.db (Fly volume mount).
# Override here for a custom path; in prod fly.toml sets this to /data/hammer.db.
STORAGE_DB_PATH=./data/hammer.db

# Anthropic API key — powers the LLM-generated vessel summaries and
# disruption narratives. When unset, /api/llm/* endpoints return 503
# "LLM disabled" instead of crashing.
ANTHROPIC_API_KEY=
